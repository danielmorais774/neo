# neo-voice service — copie para `.env` e preencha. Lido automaticamente no boot
# (service/neo_voice_server.py). Vars ja exportadas no shell tem prioridade.

# --- Fallback de STT via OpenRouter (so quando o PC gamer/Parakeet esta offline) ---
# Sem esta chave o fallback fica DESLIGADO (so o engine local e usado).
OPENROUTER_API_KEY=sk-or-...

# Opcionais (defaults entre parenteses):
# NEO_STT_OPENROUTER_MODEL=nvidia/parakeet-tdt-0.6b-v3
# NEO_STT_FALLBACK=1                 # 0/false desliga o fallback mesmo com chave
# NEO_STT_FALLBACK_PARTIALS=0        # 1 manda tambem as parciais p/ a nuvem (mais caro)
# NEO_STT_ENGINE_DOWN_COOLDOWN=15    # s indo direto p/ OpenRouter apos falha do local
# NEO_STT_ENGINE_CONNECT_TIMEOUT=4   # s p/ detectar o PC gamer caido
# NEO_STT_ENGINE_TIMEOUT=20          # s de leitura da transcricao local
# NEO_STT_OPENROUTER_TIMEOUT=30      # s de timeout do OpenRouter

# --- Monitor de alcancabilidade dos engines (tabela de status em RAM) ---
# Poller em background que mantem up/down por engine; STT/TTS leem a tabela e vao
# direto pro fallback quando o primario esta down (sem pagar timeout). Ver /engines/status.
# NEO_VOICE_MONITOR=1                 # 0/false desliga o poller (volta ao probe por request)
# NEO_VOICE_MONITOR_INTERVAL=4        # s entre varreduras do /health de cada engine
# NEO_VOICE_MONITOR_PROBE_TIMEOUT=2  # s de timeout de cada probe (curto p/ pegar backend WSL morto)
# NEO_VOICE_MONITOR_FAIL_THRESHOLD=2 # falhas seguidas do poller p/ marcar down (request real marca na hora)

# --- Outras envs do service (defaults ja funcionam na LAN do usuario) ---
# NEO_STT_ENGINE_URL=http://192.168.4.185:5005
# NEO_TTS_ENGINE_URL=http://192.168.4.185:5006
# NEO_STT_APIKEY=
# NEO_CORE_URL=
# NEO_STT_PORT=5002
