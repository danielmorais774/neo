.message-text {
  word-wrap: break-word;
}

.message-text code {
  background: var(--code-bg);
  padding: 2px 6px;
  border-radius: 4px;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 13px;
}

.message-text pre {
  background: var(--code-bg);
  padding: 12px;
  border-radius: 8px;
  overflow-x: auto;
  margin: 8px 0;
}

.message-text pre code {
  background: transparent;
  padding: 0;
}

.message-time {
  font-size: 10px;
  color: var(--text-secondary);
  margin-top: 6px;
  opacity: 0.7;
}

.message.user .message-time {
  text-align: right;
}

.command-explanation {
  padding: 8px 12px;
  font-size: 12px;
  color: var(--text-secondary);
  background: rgba(233, 69, 96, 0.1);
  border-left: 3px solid var(--accent);
}
