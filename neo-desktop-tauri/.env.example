# Variáveis de ambiente do Neo Desktop (lidas via std::env no Rust em runtime).
# Exporte-as no ambiente onde você roda `tauri dev` (não há auto-load de .env).

# --- Modo Live (voz) — neo-voice ---
# Default (sem env): ws://192.168.4.210:5002 — neo-voice no neo-host (LXC) da LAN.
# Descomente p/ sobrescrever (ex.: ws://127.0.0.1:5002 se usar um tunnel local).
# NEO_VOICE_WS_URL=ws://192.168.4.210:5002
# NEO_VOICE_TTS_BACKEND=coqui

# --- Wake word (Estágio 1 do Modo Live) — sidecar local, offline ---
# DEFAULT ATUAL: openWakeWord (modelo ei_neo.onnx v3, treinado na 5070 Ti).
# WAKE ("ei neo") = openWakeWord; STOP/barge-in ("pare") = EfficientWord-Net.
# O Rust já usa neo_wake_oww.py + limiar 0.6 por default (wake.rs::from_env),
# então NÃO precisa exportar nada abaixo — é só p/ sobrescrever/reverter.
# Liga o autostart do detector ao abrir o app (a UI também liga/desliga depois).
NEO_WAKE_ENABLED=1
# Caminhos ABSOLUTOS são mais robustos (default relativo assume CWD=src-tauri).
# .venv-eff tem os DOIS frameworks (openwakeword + eff_word_net).
NEO_WAKE_PYTHON=/Users/daniel/Documents/projects/neo/neo-desktop-tauri/sidecar/wake/.venv-eff/bin/python
NEO_WAKE_SCRIPT=/Users/daniel/Documents/projects/neo/neo-desktop-tauri/sidecar/wake/neo_wake_oww.py
# NEO_WAKE_THRESHOLD=0.6      # openWakeWord 0..1 (subir = menos FP / descer = mais recall)
# NEO_WAKE_OWW_FRAMES=2       # frames consecutivos >= limiar p/ disparar
# Refs default: ~/Library/Application Support/neo-desktop/wake/refs (gerido pela UI)
# NEO_WAKE_REFS_DIR=...
# NEO_WAKE_COOLDOWN_MS=3000
#
# REVERTER ao detector antigo (few-shot EfficientWord-Net):
#   NEO_WAKE_SCRIPT=.../sidecar/wake/neo_wake.py
#   NEO_WAKE_THRESHOLD=0.64
