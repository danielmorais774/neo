# faz hairpin: do sandbox, `curl http://203.0.113.10:8000` caía na API do
# neo-core sem autenticação nenhuma. As portas agora são loopback-only, mas o
# filtro fecha o caminho por construção, não por configuração de outro arquivo.
^178\.18\.241\.170$
^2a02:c207:2333:7942::1$

# --- IPv6 privados / loopback / link-local ---
^::1$
^f[cd][0-9a-f]{2}:
^fe80:

# --- nomes internos ---
localhost
\.local$
\.lan$
\.internal$
