# Lista de permissão: tudo na raiz fica fora, menos o que está liberado abaixo.
# A raiz tem .env, backups, vídeos e laboratórios de vários GB que NUNCA entram.
/*
!/.gitignore
!/.gitattributes
!/.mailmap
!/.gitleaks.toml
!/README.md
!/README.en.md
!/LICENSE
!/.env.example
!/docker-compose.yml
!/proto/
!/docker/
!/evals/
!/neo-core/
!/neo-desktop-tauri/
!/neo-panel/
!/neo-whatsapp/
!/neo-voice/
!/neo-browser-local/
!/neo-music-ext/
!/neo-mobile/
!/session-worker-proxy/

# Nunca, em pasta nenhuma.
.env
.env.*
!.env.example
*.pem
*.key
*.sql
*.dump
keys/
logs/*
!logs/.gitkeep
!logs/.gitignore
node_modules/
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
target/
dist/
.DS_Store

# Pesos de modelo, áudio e saídas geradas.
models/
*.onnx
*.pt
*.bin
*.safetensors
*.jit
*.tflite
*.wav
*.mp3
*.ogg
*.flac
*.m4a
/neo-whatsapp/auth/
/neo-voice/**/state/
/neo-voice/**/cache/

# Gabarito do ranking do PKS: 50 trechos de conversas REAIS. Fica só no disco (scripts/pks_ranking_bench.py).
/neo-core/tests/pks_ranking/golden.yaml

# Notas de trabalho da organização do repositório (fica só no disco).
/neo-core/docs/plano-monorepo-e-readme.md
