# Neo Core Environment Variables

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=

# Ollama Base URL (optional, for local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# ── Auth da API HTTP (neo-core/docs/api-auth-plan.md) ────────────────────────
# Portão de autenticação das rotas. Suba os degraus NESTA ordem — os clientes
# precisam carregar a credencial antes do enforce, senão o desktop leva 401 no
# meio de um turno:
#   off      = como antes de existir auth (rollback de incidente)
#   shadow   = resolve o principal, LOGA e deixa passar (padrão; grep app.log
#              por "[auth:sombra]" para ver o que o enforce barraria)
#   enforce  = 401 sem credencial; o JWT estático do painel ainda vale na
#              administração
#   strict   = só token de aparelho pareado e login de usuário
NEO_API_AUTH_MODE=shadow

# Assina TODOS os JWT (o legado do painel e o access token do login). O default
# do código está NO REPOSITÓRIO: sem trocar isto, quem lê o repo emite token de
# admin. Gere com: openssl rand -base64 48
PANEL_JWT_SECRET=

# Recusa SUBIR com o segredo acima no default embutido. Ligue junto com o enforce.
NEO_API_AUTH_SECRET_REQUIRED=false

# Validade do access token do login (s) e do refresh (s, opaco e revogável).
ACCESS_TOKEN_TTL_S=1800
REFRESH_TOKEN_TTL_S=2592000

# Exige token de pareamento nos canais de device (WS + gRPC). Já ligado em prod.
NEO_DEVICE_AUTH_REQUIRED=true

# WhatsApp (neo-whatsapp): único número autorizado e destino do /notify, só dígitos com DDI
ALLOWED_WHATSAPP_PHONE=5500000000000
NOTIFY_WHATSAPP_PHONE=5500000000000

# Senhas dos bancos (docker-compose.yml)
NEO_DB_PASSWORD=troque-esta-senha
LETTA_DB_PASSWORD=troque-esta-senha

# SearXNG (docker/searxng/settings.yml lê daqui): openssl rand -hex 32
SEARXNG_SECRET=

# Provedores de LLM
DEEPSEEK_API_KEY=
DEFAULT_MODEL=
DEFAULT_PROVIDER=
GEMINI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
NEO_BROWSER_LLM=
NEO_BROWSER_OPENROUTER_KEY=
OPENROUTER_API_KEY=

# Funcionalidades (liga/desliga)
BROWSER_LOCAL_ENABLED=true
BROWSER_LOCAL_MAX_STEPS=25
CLAUDE_CODE_ENABLED=true
NEO_AFFECT_ENABLED=true
NEO_AFFECT_ROUTER_HINT_ENABLED=true
NEO_AFFECT_ROUTE_TO_BRAIN=
NEO_AFFECT_SKILL_DIRECTIVE_ENABLED=true
NEO_BIRRA_ENABLED=true
NEO_BIRRA_MAX_PHYSICAL_ACTS=2
NEO_DATASETS_ENABLED=true
NEO_EVENTS_ENABLED=true
NEO_FILES_ENABLED=true
NEO_FILE_ACTUATION_ENABLED=true
NEO_GATEWAY_ENABLED=true
NEO_RELEASE_GATE_MODE=
NEO_SCHEDULER_ENABLED=true
NEO_SKILL_AUTO_INSTALL=false
NEO_SKILL_PY_TOOLS_ENABLED=false
NEO_TOOL_INDEX_ENABLED=false
SKILLS_DISCOVERY_DEFAULT=
WORKING_MEMORY_ENABLED=true

# Integrações
BROWSER_LOCAL_BLOCKED_DOMAINS=
BROWSER_LOCAL_MODEL=
HOME_ASSISTANT_TIMEOUT=10
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_URL=
ML_APP_ID=
ML_CLIENT_SECRET=
NEO_CRED_KEY=
NEO_VOICE_URL=http://neo-voice:5002
NOTIFY_TOKEN=
PCGAMER_HOST=
SESSION_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
