{
  "manifest_version": 3,
  "name": "Neo Browser Local",
  "description": "Braço do Neo no navegador local: o neo-core dirige a aba que você está vendo, com um painel lateral mostrando cada passo e o botão PARE.",
  "version": "0.3.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Neo Browser Local",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:;"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/cursor-chat.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "downloads.ui",
    "history",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-overlay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
